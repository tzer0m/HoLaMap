@page
@model HoLaMap.Pages.Schedule.IndexModel
@using HoLaMap.Schedules
@{
    ViewData["Title"] = "Schedule";
}

<header class="page-header">
    <h1>Schedule</h1>
    <div class="legend-rows">
        <ul class="legend">
            @foreach (KeyValuePair<string, string> host in Model.Colours)
            {
                string state = Model.Host == null ? string.Empty : Model.Host == host.Key ? " active" : " faded";
                <li><a class="legend-filter@(state)" asp-page="/Schedule/Index" asp-route-host="@(Model.Host == host.Key ? null : host.Key)" asp-route-source="@Model.Source" title="@(Model.Host == host.Key ? "Show every host" : $"Show only {host.Key}")"><span class="swatch" style="background: @host.Value"></span>@host.Key</a></li>
            }
        </ul>
        <ul class="legend">
            @foreach (ScheduleSource source in Model.Sources)
            {
                string state = Model.Source == null ? string.Empty : Model.Source == source ? " active" : " faded";
                string label = IndexModel.Label(source);
                <li><a class="legend-filter@(state)" asp-page="/Schedule/Index" asp-route-host="@Model.Host" asp-route-source="@(Model.Source == source ? null : source.ToString())" title="@(Model.Source == source ? "Show every source" : $"Show only {label}")"><span class="swatch schedule-source source-@source.ToString().ToLowerInvariant()"></span>@label</a></li>
            }
        </ul>
    </div>
</header>

@if (!Model.Any)
{
    <p class="empty">Nothing scheduled yet. Tasks show here from Semaphore, once its address and API token are set, and from the systemd timers and TrueNAS tasks hosts report.</p>
}
else
{
    @if (Model.Unread.Count > 0)
    {
        <p class="empty">Couldn't read the schedule of @string.Join(", ", Model.Unread.Select(task => $"{task.Name} ({task.Schedule})")), so they're not on any bar.</p>
    }
    <div class="schedule-layout">
        <div class="schedule-bars">
            @foreach (ScheduleBar bar in Model.Bars)
            {
                <section class="schedule-bar">
                    <h2>@bar.Title <span>@bar.Span</span></h2>
                    <div class="schedule-body">
                        <div class="schedule-axis">
                            @foreach (ScheduleTick tick in bar.Ticks.Where(tick => tick.Label.Length > 0))
                            {
                                <span style="top: @IndexModel.Percent(tick.Position)">@tick.Label</span>
                            }
                        </div>
                        <div class="schedule-track" style="--lanes: @Math.Max(bar.Lanes, 1)">
                            @foreach (ScheduleTick tick in bar.Ticks.Where(tick => tick.Line))
                            {
                                <span class="schedule-line" style="top: @IndexModel.Percent(tick.Position)"></span>
                            }
                            @foreach (ScheduleBlock block in bar.Blocks)
                            {
                                <button type="button" class="schedule-block source-@block.Source.ToString().ToLowerInvariant()@(block.Inactive ? " inactive" : "")" data-task="@block.TaskId" title="@block.Title · @IndexModel.Label(block.Source)" style="top: @IndexModel.Percent(block.Start); height: @IndexModel.Percent(block.Width); --lane: @block.Lane; --host-colour: @Model.Colours[block.Host]">@block.Name</button>
                            }
                            @if (bar.Blocks.Count == 0 && bar.Strips.Count == 0)
                            {
                                <p class="schedule-empty">Nothing runs here.</p>
                            }
                        </div>
                        @foreach (ScheduleStrip strip in bar.Strips)
                        {
                            <button type="button" class="schedule-strip source-@strip.Source.ToString().ToLowerInvariant()@(strip.Inactive ? " inactive" : "")" data-task="@strip.TaskId" title="@strip.Label · @IndexModel.Label(strip.Source)" style="--host-colour: @Model.Colours[strip.Host]">
                                <svg viewBox="0 0 10 1000" preserveAspectRatio="none" aria-hidden="true"><path d="@IndexModel.Marks(strip.Positions)" /></svg>
                            </button>
                        }
                    </div>
                </section>
            }
        </div>
        <aside id="schedule-details" class="details">Select a task to see its details.</aside>
    </div>
    <script id="schedule-data" type="application/json">@Html.Raw(Model.Details)</script>
}

@section Scripts {
    <script src="~/js/schedule.js" asp-append-version="true"></script>
}