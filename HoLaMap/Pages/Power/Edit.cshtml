@page
@model HoLaMap.Pages.Power.EditModel
@{
    ViewData["Title"] = Model.Machine == null ? "Add Machine" : $"Edit {Model.Machine.Name}";
}

<header class="page-header">
    <h1>@ViewData["Title"]</h1>
</header>

<form method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    @if (Model.Machine == null)
    {
        <label>
            Device
            <select asp-for="DeviceId" asp-items="Model.DeviceOptions">
                <option value="">Choose a device…</option>
            </select>
            <span asp-validation-for="DeviceId" class="field-error"></span>
        </label>
    }
    else
    {
        <input type="hidden" asp-for="DeviceId" />
        <p class="empty">@Model.Machine.Ip · @Model.Machine.Mac</p>
        if (Model.MacOptions.Count > 1)
        {
            <label>
                Wake MAC Address
                <select asp-for="WakeMac" asp-items="Model.MacOptions"></select>
            </label>
        }
    }
    <label>
        Wake Interface
        <input asp-for="WakeInterface" placeholder="Leave empty if it can't be woken" />
    </label>
    <label>
        Semaphore Host
        <input asp-for="SemaphoreHost" placeholder="Its name in the Semaphore inventory, or empty if it can't be powered off" />
    </label>
    <label>
        Semaphore Inventory ID
        <input asp-for="SemaphoreInventoryId" type="number" min="1" />
    </label>
    <label class="form-check">
        <input asp-for="CanSleep" />
        Can Sleep
    </label>
    <label class="form-check">
        <input asp-for="CanPowerOff" />
        Can Power Off
    </label>
    <label>
        Check Port
        <input asp-for="PowerCheckPort" type="number" min="1" max="65535" placeholder="Leave empty to ping" />
    </label>
    <div class="form-actions">
        <button type="submit" class="button">Save</button>
        <a asp-page="Index">Cancel</a>
    </div>
</form>

@if (Model.Machine != null)
{
    <form method="post" asp-page-handler="Remove" asp-route-id="@Model.Machine.Id" class="power-remove">
        <button type="submit" class="button button-danger">Remove from Power</button>
    </form>
}