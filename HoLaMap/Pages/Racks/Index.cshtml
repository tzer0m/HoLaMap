@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model IndexModel
@{
    ViewData["Title"] = "Racks";
}

<header class="page-header">
    <h1>Racks</h1>
</header>

@if (Model.RoomOptions.Count == 0)
{
    <p class="empty">Add a floor and a room on the floor plan first.</p>
}
else
{
    <form method="post" asp-page-handler="Add" class="inline-form rack-add">
        <input name="name" placeholder="Rack Name" required />
        <select name="roomId">
            @foreach (IGrouping<string?, SelectListItem> group in Model.RoomOptions.GroupBy(option => option.Group?.Name))
            {
                <optgroup label="@group.Key">
                    @foreach (SelectListItem option in group)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                </optgroup>
            }
        </select>
        <input name="heightU" type="number" min="1" value="12" title="Height in U" />
        <button type="submit" class="button">Add Rack</button>
    </form>
}

@if (Model.Racks.Count == 0)
{
    <p class="empty">No racks yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Rack</th>
                <th>Room</th>
                <th>Height</th>
                <th>Devices</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Rack rack in Model.Racks)
            {
                <tr>
                    <td><a asp-page="Details" asp-route-id="@rack.Id">@rack.Name</a></td>
                    <td>@rack.Room.Floor.Name / @rack.Room.Name</td>
                    <td>@rack.HeightU U</td>
                    <td>@rack.Devices.Count</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@rack.Id" onsubmit="return confirm('Delete this rack? Its devices stay in the room.')">
                            <button type="submit" class="button button-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}