@page
@model HoLaMap.Pages.Links.CreateModel
@{
    ViewData["Title"] = "Add Link";
}

<header class="page-header">
    <h1>Add Link</h1>
</header>

<form method="post" class="form">
    <label>
        From Port
        <select asp-for="FromPortId" asp-items="Model.PortOptions">
            <option value="">Choose a port…</option>
        </select>
        <span asp-validation-for="FromPortId" class="field-error"></span>
    </label>
    <label>
        To
        <select asp-for="Target" asp-items="Model.TargetOptions">
            <option value="">Choose a device or port…</option>
        </select>
        <span asp-validation-for="Target" class="field-error"></span>
    </label>
    <label>
        Notes
        <input asp-for="Notes" placeholder="e.g. WAN loopback for the ISP VLAN" />
    </label>
    <div class="form-actions">
        <button type="submit" class="button">Save</button>
        <a asp-page="Index">Cancel</a>
    </div>
</form>