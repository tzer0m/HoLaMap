@page
@model IndexModel
@{
    ViewData["Title"] = "Map";
}

<header class="page-header">
    <h1>Map</h1>
    <ul class="legend">
        <li><span class="swatch port-wan"></span>WAN</li>
        <li><span class="swatch port-gbe-poe"></span>GbE PoE</li>
        <li><span class="swatch port-gbe"></span>GbE</li>
        <li><span class="swatch port-fe"></span>FE</li>
        <li><span class="swatch port-down"></span>Down</li>
        <li><span class="swatch swatch-manual"></span>Manual</li>
    </ul>
</header>

<div class="map-layout">
    <div id="map" class="map" data-graph-url="@Url.Page("/Index", "Graph")"></div>
    <aside id="details" class="details">Select a device or link to see its details.</aside>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/elkjs@0.9.3/lib/elk.bundled.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}