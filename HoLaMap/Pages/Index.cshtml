@page
@model IndexModel
@{
    ViewData["Title"] = "Map";
}

<header class="page-header">
    <h1>Map</h1>
    <div id="legend" class="legend-rows">
        <ul class="legend">
            <li data-key="port-1000"><span class="swatch port-1000"></span>1 Gbps</li>
            <li data-key="port-100"><span class="swatch port-100"></span>100 Mbps</li>
            <li data-key="port-10"><span class="swatch port-10"></span>10 Mbps</li>
            <li data-key="port-wan"><span class="swatch port-wan"></span>WAN</li>
            <li data-key="port-down"><span class="swatch port-down"></span>Down</li>
            <li data-key="poe"><svg class="swatch-zigzag" viewBox="0 0 18 10"><polyline points="0,5 3,2 6,8 9,2 12,8 15,2 18,5" /></svg>PoE</li>
            <li data-key="wifi"><svg class="swatch-wave" viewBox="0 0 18 10"><path d="M 0 5 Q 2.5 0 5 5 Q 7.5 10 10 5 Q 12.5 0 15 5 Q 16.5 8 18 5" /></svg>Wi-Fi</li>
            <li data-key="zigbee"><svg class="swatch-zigbee" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Zigbee</li>
            <li data-key="link-database"><svg class="swatch-link link-database" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Database</li>
            <li data-key="link-signin"><svg class="swatch-link link-signin" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Sign-in</li>
            <li data-key="link-notification"><svg class="swatch-link link-notification" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Notification</li>
            <li data-key="link-api"><svg class="swatch-link link-api" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>API</li>
            <li data-key="link-monitoring"><svg class="swatch-link link-monitoring" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Monitoring</li>
            <li data-key="link-media"><svg class="swatch-link link-media" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Media</li>
            <li data-key="link-device"><svg class="swatch-link link-device" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Device</li>
            <li data-key="link-email"><svg class="swatch-link link-email" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Email</li>
            <li data-key="link-other"><svg class="swatch-link link-other" viewBox="0 0 18 10"><line x1="1" y1="5" x2="17" y2="5" /></svg>Other Link</li>
        </ul>
        <ul class="legend">
            <li data-key="unifi"><span class="swatch box box-unifi"></span>UniFi</li>
            <li data-key="client"><span class="swatch box box-client"></span>Client</li>
            <li data-key="rack"><span class="swatch box box-rack"></span>Rack</li>
            <li data-key="coordinator"><span class="swatch box box-coordinator"></span>Coordinator</li>
            <li data-key="router"><span class="swatch box box-router"></span>Router</li>
            <li data-key="end-device"><span class="swatch box box-zigbee"></span>End Device</li>
            <li data-key="hue"><span class="swatch box box-hue"></span>Hue Device</li>
            <li data-key="app"><span class="swatch box box-app"></span>Custom Systemd</li>
            <li data-key="service"><span class="swatch box box-service"></span>Third-Party Systemd</li>
            <li data-key="python"><span class="swatch box box-python"></span>Python Script</li>
            <li data-key="docker"><span class="swatch box box-docker"></span>Docker</li>
            <li data-key="other"><span class="swatch box box-other"></span>Other</li>
            <li data-key="cloud"><span class="swatch box box-cloud"></span>Cloud</li>
            <li data-key="hardware"><span class="swatch box box-hardware"></span>Device</li>
        </ul>
    </div>
</header>

<nav id="view-tabs" class="floor-tabs">
    <button type="button" data-view="all">All</button>
    <button type="button" data-view="floorplan">Floor Plan</button>
    <button type="button" data-view="network">Network</button>
    <button type="button" data-view="zigbee">Zigbee</button>
    <button type="button" data-view="services">Services</button>
</nav>

<div class="map-layout">
    <div class="map-wrap">
        <div id="map" class="map" data-graph-url="@Url.Page("/Index", "Graph")" data-zigbee-url="@Url.Page("/Index", "Zigbee")" data-services-url="@Url.Page("/Index", "Services")"></div>
        <select id="vlan-select" class="vlan-select" title="Network" hidden></select>
        <select id="zigbee-select" class="vlan-select" title="Zigbee Network" hidden>
            <option value="">All</option>
            <option value="zha">Zigbee</option>
            <option value="hue">Hue</option>
        </select>
        <select id="services-select" class="vlan-select" title="Category" hidden>
            <option value="">All</option>
            <option value="App">Apps</option>
            <option value="Asterisk">Asterisk</option>
            <option value="Cloudflared">Cloudflared</option>
            <option value="Exporter">Exporter</option>
            <option value="GitHub">GitHub</option>
            <option value="Semaphore">Semaphore</option>
        </select>
    </div>
    <aside id="details" class="details" data-splitter-url="@Url.Page("/Index", "Splitter")" data-room-url="@Url.Page("/Index", "Room")" data-zigbee-room-url="@Url.Page("/Index", "ZigbeeRoom")">Select a device or link to see its details.</aside>
    @Html.AntiForgeryToken()
</div>

<dialog id="rack-dialog" class="rack-dialog" data-rack-url="@Url.Page("/Racks/Details", new { id = 0 })">
    <header class="rack-dialog-header">
        <strong data-title></strong>
        <a class="button button-secondary" data-edit>Edit Rack</a>
        <button type="button" class="button button-secondary" data-close>Close</button>
    </header>
    <div class="rackmap" data-body></div>
</dialog>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/elkjs@0.9.3/lib/elk.bundled.js"></script>
    <script src="~/js/rackmap.js" asp-append-version="true"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}