@inject HoLaMapContext Database
@{
    int actionCount = Database.ActionItems.Count(item => !item.Dismissed);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">HoLaMap</a>
        <nav class="site-nav">
            <a asp-page="/Floorplan/Index">Floor Plan</a>
            <a asp-page="/Racks/Index">Racks</a>
            <a asp-page="/Devices/Index">Devices</a>
            <a asp-page="/Links/Index">Links</a>
            <a asp-page="/Actions/Index">
                Actions
                @if (actionCount > 0)
                {
                    <span class="badge">@actionCount</span>
                }
            </a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>