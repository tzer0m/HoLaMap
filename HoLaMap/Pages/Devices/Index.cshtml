@page
@model IndexModel
@{
    ViewData["Title"] = "Devices";
}

<header class="page-header">
    <h1>Devices</h1>
    <a class="button" asp-page="Merge">Merge Devices</a>
    <ul class="legend">
        <li><span class="swatch port-1000"></span>1 Gbps</li>
        <li><span class="swatch port-100"></span>100 Mbps</li>
        <li><span class="swatch port-10"></span>10 Mbps</li>
        <li><span class="swatch port-wan"></span>WAN</li>
        <li><span class="swatch port-down"></span>Down</li>
        <li><svg class="swatch-zigzag" viewBox="0 0 18 10"><polyline points="0,5 3,2 6,8 9,2 12,8 15,2 18,5" /></svg>PoE</li>
    </ul>
</header>

@if (Model.Infrastructure.Count == 0)
{
    <p class="empty">No devices yet. Wait for the first UniFi sync.</p>
}

@foreach (Device device in Model.Infrastructure)
{
    <section class="device device-@device.Kind.ToString().ToLowerInvariant()">
        <header class="device-header">
            <span class="device-name">@device.Name</span>
            <span class="device-meta">@device.Model · @device.Ip</span>
        </header>
        @if (device.Ports.Count == 0)
        {
            <p class="device-empty">Wireless Only</p>
        }
        else
        {
            <div class="ports">
                @foreach (Port port in device.Ports.OrderBy(port => port.Index))
                {
                    List<string> connections = Model.Connections(port);
                    <div class="port @PortStyle.Class(port)" title="@PortStyle.Tooltip(port)">
                        <span class="port-index">@port.Index</span>
                        @foreach (string connection in connections)
                        {
                            <span class="port-connection">@connection</span>
                        }
                    </div>
                }
            </div>
        }
    </section>
}