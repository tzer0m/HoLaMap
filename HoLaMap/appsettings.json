{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UniFi": {
    "BaseUrl": "https://192.168.1.1/",
    "Site": "default",
    "SyncIntervalMinutes": 5,
    "ForgetAfterDays": 30
  },
  "HomeAssistant": {
    "Url": "http://192.168.20.132:8123/",
    "SyncIntervalMinutes": 15,
    "CoordinatorHost": "Brienne",
    "ForgetAfterDays": 30
  },
  "Hue": {
    "BridgeHost": "Hue Bridge",
    "SyncIntervalMinutes": 15,
    "ForgetAfterDays": 30
  },
  "Hosts": {
    "ForgetAfterDays": 30,
    "SystemdInclude": [ "asterisk", "nginx", "tailscaled" ],
    "Categories": {
      "cloudflared": "Cloudflared",
      "node_exporter": "Exporter",
      "semaphore": "Semaphore",
      "tailscaled": "Tailscale",
      "actions.runner.*": "GitHub",
      "asterisk": "Asterisk"
    }
  },
  "Map": {
    "OfflineAfterMinutes": 15
  }
}