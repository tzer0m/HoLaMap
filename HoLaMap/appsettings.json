{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UniFi": {
    "BaseUrl": "https://192.168.1.1/",
    "Site": "default",
    "SyncIntervalMinutes": 5,
    "ForgetAfterDays": 30
  },
  "HomeAssistant": {
    "Url": "http://192.168.20.132:8123/",
    "SyncIntervalMinutes": 15,
    "CoordinatorHost": "Brienne",
    "ForgetAfterDays": 30
  },
  "Hue": {
    "BridgeHost": "Hue Bridge",
    "SyncIntervalMinutes": 15,
    "ForgetAfterDays": 30
  },
  "Hosts": {
    "ForgetAfterDays": 30,
    "SystemdInclude": [ "asterisk", "nginx", "postfix", "tailscaled" ],
    "DockerIgnore": [ "init", "permissions", "postgres_upgrade" ],
    "Categories": {
      "cloudflared": "Cloudflared",
      "node_exporter": "Exporter",
      "cadvisor": "Exporter",
      "unpoller": "Exporter",
      "node-exporter": "Exporter",
      "zfs-exporter": "Exporter",
      "postgres-exporter": "Exporter",
      "semaphore": "Semaphore",
      "actions.runner.*": "GitHub",
      "asterisk": "Asterisk"
    }
  },
  "OpenApi": {
    "SyncIntervalMinutes": 60,
    "Sources": [
      {
        "Host": "Tyrion",
        "Service": "Api",
        "Url": "https://api.tzer0m.co.uk/swagger/v1/swagger.json"
      }
    ]
  },
  "Map": {
    "OfflineAfterMinutes": 15
  }
}